# Deterministic local demo; no network model or live travel-provider requests.
ROAMREADY_DEMO_MODE=1
TRIP_SCOUT_HOST=127.0.0.1
TRIP_SCOUT_PORT=8765
SIM_PORT=8770
TRIP_SCOUT_DB=./roamready-demo.db

# Optional model configuration. Leave LLM_PROVIDER unset for the default.
# To opt in to Amazon Bedrock, set LLM_PROVIDER=bedrock, AWS_REGION, and
# AWS_BEARER_TOKEN_BEDROCK. The model path can incur AWS charges.
# AWS credentials must never be committed to this file or the repository.
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=
# LLM_MODEL=openai.gpt-oss-120b-1:0
# ROAMREADY_DEMO_MODE=0
